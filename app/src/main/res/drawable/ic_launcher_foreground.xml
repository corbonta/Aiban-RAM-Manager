                    android:centerY="56"
                    android:gradientRadius="38"
                    android:startColor="#5500E676"
                    android:endColor="#0000E676" />
            </aapt:attr>
        </path>

        <!-- Перья над бровью -->
        <path
            android:fillColor="#6B4528"
            android:pathData="M31,38L29,22L45,35Z" />
        <path
            android:fillColor="#6B4528"
            android:pathData="M45,36L50,18L60,36Z" />
        <path
