                    android:centerX="58"
                    android:centerY="59"
                    android:gradientRadius="14"
                    android:startColor="#FFE066"
                    android:endColor="#F08A00" />
            </aapt:attr>
        </path>

        <!-- Зрачок -->
        <path
            android:fillColor="#0A0A0A"
            android:pathData="M51,59a7,7 0 1,0 14,0a7,7 0 1,0 -14,0z" />

